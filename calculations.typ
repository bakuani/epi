#let ucp-hours = if pf == none { none } else { florcat-ucp * pf }
#let reserve = 0.10
#let final-hours = calc.ceil(pert-hours * (1 + reserve) / 100) * 100

// Формат таблиц: заголовок повторяется при переносе страницы.
#let tbl(..args) = {
  set par(first-line-indent: 0pt, justify: false, leading: 0.45em)
  set table.cell(breakable: false)
  let cols = args.named().at("columns")
  let cells = args.pos()
  table(stroke: 0.5pt, inset: 4pt, align: left + horizon,
    ..args.named(), table.header(..cells.slice(0, cols.len())), ..cells.slice(cols.len()))
}
#let fp-summary() = block(breakable: false, tbl(
  columns: (15%, 17%, 17%, 17%, 16%, 18%),
  [Тип], [Низкая], [Средняя], [Высокая], [Число], [UFP],
  ..("EI", "EO", "EQ").map(kind => {
    let rows = transactions.filter(r => r.at(0) == kind)
    (kind, ..(0, 1, 2).map(level => fmt(sum-of(rows.filter(r => tx-level(kind, r.at(3), r.at(4).len()) == level).map(r => r.at(2))))),
      fmt(sum-of(rows.map(r => r.at(2)))), fmt(sum-of(rows.map(r => r.at(2) * tx-weight(r)))))
  }).flatten(),
  [ILF], ..(0, 1, 2).map(level => fmt(files.filter(r => data-level(r.at(2), r.at(3)) == level).len())), fmt(files.len()), fmt(ilf-total),
  [EIF], [0], [0], [0], [0], [0],
  [*Итого*], [], [], [], [], [*#fmt(ufp)*],
))
#let uc-summary(rows, actors) = block(breakable: false, tbl(
  columns: (42%, 20%, 18%, 20%), [Класс], [Количество], [Вес], [Вклад],
  ..(("Простой: 1–3", 5), ("Средний: 4–7", 10), ("Сложный: 8 и более", 15)).map(c => {
    let n = rows.filter(r => uc-weight(r) == c.at(1)).len()
    (c.at(0), fmt(n), fmt(c.at(1)), fmt(n * c.at(1)))
  }).flatten(),
  [*UUCW*], [], [], [*#fmt(sum-of(rows.map(uc-weight)))*],
  [UAW], [], [], fmt(actors),
  [*UUCP*], [], [], [*#fmt(sum-of(rows.map(uc-weight)) + actors)*],
))
#let uc-detail(rows, prefix) = tbl(
  columns: (9%, 24%, 51%, 8%, 8%), [ID], [Цель / связь], [Транзакции (разделены «;»)], [N], [Вес],
  ..rows.enumerate().map(((i, r)) => (
    prefix + str(i + 1), [#r.at(0) #linebreak() #text(size: 8pt)[#r.at(1)]],
    r.at(2), fmt(uc-count(r)), fmt(uc-weight(r)),
  )).flatten(),
)
