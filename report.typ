#let tx-level(kind, det, ftr) = {
  let row = if kind == "EI" {
    if ftr <= 1 { 0 } else if ftr == 2 { 1 } else { 2 }
  } else { if ftr <= 1 { 0 } else if ftr <= 3 { 1 } else { 2 } }
  let col = if kind == "EI" {
    if det <= 4 { 0 } else if det <= 15 { 1 } else { 2 }
  } else { if det <= 5 { 0 } else if det <= 19 { 1 } else { 2 } }
  ((0, 0, 1), (0, 1, 2), (1, 2, 2)).at(row).at(col)
}
#let tx-weight(r) = (if r.at(0) == "EO" { (4, 5, 7) } else { (3, 4, 6) }).at(tx-level(r.at(0), r.at(3), r.at(4).len()))
#let ilf-weight(r) = (7, 10, 15).at(data-level(r.at(2), r.at(3)))
#let ilf-total = sum-of(files.map(ilf-weight))
#let ufp = ilf-total + sum-of(transactions.map(r => r.at(2) * tx-weight(r)))
#let sloc-per-fp = 47
#let ksloc = ufp * sloc-per-fp / 1000
#let scale-factors = (("PREC", "Прецедентность", 3.72), ("FLEX", "Гибкость", 3.04), ("RESL", "Разрешение рисков", 4.24), ("TEAM", "Сплочённость", 3.29), ("PMAT", "Зрелость процесса", 4.68))
