  [UUCW], fmt(uucw), fmt(ref-uucw),
  [UUCP], fmt(uaw + uucw), fmt(ref-uaw + ref-uucw),
  [TCF], fmt(tcf, digits: 3), fmt(ref-tcf, digits: 3),
  [ECF], fmt(ecf, digits: 3), fmt(ref-ecf, digits: 3),
  [$"UCP"'$], fmt(florcat-ucp, digits: 2), fmt(ref-ucp, digits: 2),
  [Затраты завершённого проекта (по памяти), чел.-ч], [—], fmt(ref-hours),
  [PF, чел.-ч/точку], fmt(pf, digits: 4), fmt(pf, digits: 4),
  [*Оценка по UCP, чел.-ч*], [*#fmt(ucp-hours, digits: 1)*], [—],
)
]


= Сравнение и итоговая оценка

#tbl(columns: (28%, 21%, 18%, 33%), [Метод], [чел.-ч], [чел.-мес.], [Ограничение],
  [Наивный: сумма $M_i$], fmt(naive-hours), fmt(naive-hours / hours-per-pm, digits: 2), [Экспертная декомпозиция],
  [PERT: $E$], fmt(pert-hours, digits: 1), fmt(pert-hours / hours-per-pm, digits: 2), [Та же WBS, учтены сценарии],
  [PERT: $E_(95%)$], fmt(pert-high, digits: 1), fmt(pert-high / hours-per-pm, digits: 2), [Приближение по лекции],
  [UCP по курсовой], if ucp-hours == none { [Нет данных часов] } else { fmt(ucp-hours, digits: 1) }, if ucp-hours == none { [—] } else { fmt(ucp-hours / hours-per-pm, digits: 2) }, [Перенос учебного опыта с ИИ],
  [FP + COCOMO II], fmt(cocomo-hours + cocomo-extra-hours), fmt((cocomo-hours + cocomo-extra-hours) / hours-per-pm, digits: 2), [Плюс анализ и ввод из WBS],
)

- *Наивный метод и PERT* используют один и тот же перечень работ, поэтому их близость ожидаема и не служит независимым подтверждением точности.
- *COCOMO II* даёт более высокую оценку. Она зависит от перевода FP в строки кода и от номинальных коэффициентов. В отличие от экспертных часов, этот расчёт не откалиброван под разработку с ИИ; сближать результаты произвольным множителем нельзя.
- *UCP* даёт #fmt(ucp-hours, digits: 1) чел.-ч — в #fmt(pert-hours / ucp-hours, digits: 1) раза меньше PERT. Обе оценки предполагают ИИ. Разрыв указывает на ограниченность переноса PF с учебной курсовой и неопределённость её часов: соотношение UCP не гарантирует таких же затрат на проверку и ввод. Результат используем для сравнения.

За основу возьмём верхнюю оценку PERT $E_(95%)$, учитывающую состав работ и их неопределённость. Усреднение результатов без данных об ошибках методов не обосновано. Резерв уже учтён слагаемым $2 dot "СКО"$; вероятностный смысл границы условен из-за зависимости работ.

$ E_(95%) = #fmt(pert-hours, digits: 1) + 2 dot #fmt(pert-sigma, digits: 2) approx #fmt(pert-high, digits: 1) " чел.-ч". $

После округления вверх до сотен принят итоговый объём *#fmt(final-hours) чел.-ч*, или *#fmt(final-hours / hours-per-pm, digits: 2) чел.-мес.*
