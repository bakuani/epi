#let naive-hours = sum-of(wbs.map(r => r.at(2)))
#let expected(r) = (r.at(1) + 4 * r.at(2) + r.at(3)) / 6
#let stddev(r) = (r.at(3) - r.at(1)) / 6
#let variance(r) = calc.pow(stddev(r), 2)
#let pert-hours = sum-of(wbs.map(expected))
#let pert-var = sum-of(wbs.map(variance))
#let pert-sigma = calc.sqrt(pert-var)
#let pert-low = pert-hours - 2 * pert-sigma
#let pert-high = pert-hours + 2 * pert-sigma

